<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Airlock.Cli</RootNamespace>
    <AssemblyName>airlock</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Global tool packaging">
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>airlock</ToolCommandName>
    <PackageId>Airlock</PackageId>
    <Description>Run an AI coding agent inside a disposable Windows Sandbox, with the target project as the only writable host folder.</Description>
    <PackageTags>windows-sandbox;sandbox;ai;agent;claude;isolation;cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\nupkg</PackageOutputPath>
    <RollForward>latestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Airlock.Core\Airlock.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

</Project>
